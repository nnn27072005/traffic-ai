# docker/Dockerfile.api
FROM python:3.12-slim

# Prevents Python from writing .pyc files and keeps stdout/stderr unbuffered
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies for OpenCV, PostgreSQL, and other C-based libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies first for caching
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source and migration configs
COPY src/ ./src/
COPY configs/ ./configs/
COPY alembic/ ./alembic/
COPY alembic.ini .

# Default environment variables
ENV TRAFFIC_MODEL=/app/models/traffic.pt
ENV HELMET_MODEL=/app/models/helmet.pt
ENV DEVICE=cpu
ENV PORT=8000

EXPOSE ${PORT}

# Run database migrations, then start the application
CMD ["sh", "-c", "alembic upgrade head && uvicorn src.api.main:app --host 0.0.0.0 --port ${PORT}"]